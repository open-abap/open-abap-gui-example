{
  "name": "open-abap-gui-example",
  "private": true,
  "version": "1.0.0",
  "description": "Simple dynpro example program in abapGit format",
  "scripts": {
    "lint": "abaplint",
    "convert": "open-abap-gui-convert",
    "build": "npm run convert && abap_transpile abap_transpile.json",
    "express": "npm run build && node express.mjs",
    "test": "playwright test",
    "test:report": "playwright show-report"
  },
  "license": "MIT",
  "devDependencies": {
    "@abaplint/cli": "^2.120.85",
    "@abaplint/database-sqlite": "^2.13.83",
    "@abaplint/open-abap-gui-converter": "^0.1.39",
    "@abaplint/runtime": "^2.14.10",
    "@abaplint/transpiler-cli": "^2.14.10",
    "@playwright/test": "^1.64.1",
    "express": "^4.22.3"
  }
}
